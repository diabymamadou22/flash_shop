# FLASH-SHOP - Fichier de configuration d'environnement

PORT=3000

# Clé secrète pour les jetons JWT d'authentification
JWT_SECRET="flash_shop_jwt_secret_token_change_in_production_2026"

# Configuration Base de données MySQL
# L'application tente automatiquement de se connecter à votre serveur MySQL.
# Si MySQL n'est pas encore démarré ou n'est pas joignable, FLASH-SHOP active 
# automatiquement le moteur SQL embarqué ultra-performant pour assurer une 
# expérience sans interruption dans l'aperçu.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="flash_shop_db"

# Clé API optionnelle
GEMINI_API_KEY=""

# APP_URL: URL de l'application injectée à l'exécution
APP_URL="http://localhost:3000"
